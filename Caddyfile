# Replace YOUR-IP-WITH-DASHES with your Hetzner IP (e.g. 1.2.3.4 → 1-2-3-4)
# Full address will be: https://1-2-3-4.sslip.io
# Let's Encrypt certificate is obtained automatically.

{$CADDY_HOST} {
    # PTSquawk API — strip prefix so Flask sees /health and /history
    handle_path /ptsquawk/* {
        reverse_proxy ptsquawk:5000
    }

    # PTEvents dashboard — preserve /ptevents prefix (aiohttp routes on it)
    handle /ptevents* {
        reverse_proxy ptevents:8080
    }

    # AI Daily Brief mindmap — static file deployed by SpotifyTranscript (run_daily.bat)
    # /aibrief and /aibrief/ both serve /srv/aibrief/mindmap.html (mounted in docker-compose)
    handle /aibrief* {
        root * /srv/aibrief
        rewrite * /mindmap.html
        file_server
    }

    # Everything else → CNCSearch
    handle {
        reverse_proxy cncsearch:8080
    }
}

# ── Cânticos públicos da Paróquia ────────────────────────────────────────────
# Requer registo DNS: A canticos → IP do servidor
# Certificado HTTPS obtido automaticamente pelo Caddy via Let's Encrypt.
# Apenas as rotas /paroquia/* são expostas — admin inacessível neste domínio.
canticos.paroquiacasaldecambra.pt {
    # Service worker Monetag (antes de tudo o resto)
    handle /sw.js {
        reverse_proxy cncsearch:8080
    }

    # Raiz → directório de cânticos
    handle / {
        redir * /paroquia permanent
    }

    # Serve apenas as páginas públicas da paróquia
    handle /paroquia* {
        reverse_proxy cncsearch:8080
    }

    # Qualquer outra rota → redireciona para o directório (não expõe admin)
    handle {
        redir * /paroquia permanent
    }
}

# ── GitLab MCP gateway for Notion ────────────────────────────────────────────
# Notion URL: https://gitlab-mcp.<ip-with-dashes>.sslip.io/mcp?token=GITLAB_PAT
# Token is passed in the query string (Notion auth = None).
gitlab-mcp.{$CADDY_HOST} {
    reverse_proxy gitlab-mcp-gateway:8808
}

# ── GarminBot MCP server (read-only health analytics for Claude) ─────────────
# Endpoint: https://garmin-mcp.<ip-with-dashes>.sslip.io/mcp
# Auth: Authorization: Bearer <GARMIN_MCP_TOKEN> (enforced by the MCP container).
# Caddy preserves the original Host header so the server's DNS-rebinding
# allowlist (MCP_ALLOWED_HOSTS) matches.
garmin-mcp.{$CADDY_HOST} {
    reverse_proxy garminbot-mcp:8000
}

# ── Phoenix — LLM observability (OTLP traces + UI) ───────────────────────────
# UI:   https://phoenix.<ip-with-dashes>.sslip.io
# OTLP: https://phoenix.<ip-with-dashes>.sslip.io/v1/traces (Bearer API key)
# Auth is enforced by Phoenix itself (PHOENIX_ENABLE_AUTH); Caddy only adds HTTPS.
phoenix.{$CADDY_HOST} {
    reverse_proxy phoenix:6006
}
